# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_.
# .env is gitignored — never commit real keys.

# ---- Firebase (already in use) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---- Stripe subscriptions ----
# Price IDs from the Stripe dashboard (Product > Pricing). They start with "price_".
# Create two recurring prices on ONE product ("11 Plus Study — Full Access"):
#   monthly £4.99, annual £34.99, each with a 7-day free trial.
# These are publishable identifiers, safe to expose in the client build.
VITE_STRIPE_PRICE_MONTHLY=
VITE_STRIPE_PRICE_ANNUAL=
