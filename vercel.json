{
  "rewrites": [
    {
      "source": "/api/portal",
      "destination": "/api/status"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://plus-app-ada37.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/owner",
      "destination": "/index.html"
    },
    {
      "source": "/tutor",
      "destination": "/index.html"
    },
    {
      "source": "/join/:code",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/inactivity",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/admin/outreach",
      "schedule": "0 9 * * 1-5"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        }
      ]
    }
  ]
}
