{
  "rewrites": [
    {
      "source": "/api/portal",
      "destination": "/api/status"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://plus-app-ada37.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/owner",
      "destination": "/index.html"
    },
    {
      "source": "/tutor",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/inactivity",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/admin/outreach",
      "schedule": "0 9 * * 1-5"
    }
  ]
}
