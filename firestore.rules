rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // True if the caller shares a friendship doc with `uid` — same doc id
    // scheme as pairId() in cloudScores.js (two uids, sorted, joined by "__").
    function isFriend(uid) {
      let me = request.auth.uid;
      let pairId = me < uid ? me + "__" + uid : uid + "__" + me;
      return exists(/databases/$(database)/documents/friendships/$(pairId));
    }

    function validDisplayName(name) {
      return name is string && name.size() >= 2 && name.size() <= 20
        && name.matches("^[\\p{L}][\\p{L} '\\-]*$");
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Public profile: get-only, never list — the whole point of Finding 1's
    // fix. Readable by its owner and by anyone who already shares a
    // friendship doc with them; nobody else, and never enumerable.
    match /profiles/{uid} {
      allow get: if isOwner(uid) || (signedIn() && isFriend(uid));
      allow write: if isOwner(uid)
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && request.resource.data.weekPoints is number
        && request.resource.data.weekPoints >= 0
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 12;
    }

    // codes/{code} -> { uid, displayName }. Lets someone look a friend up by
    // their exact code (get) without the profiles collection ever needing to
    // be listable (Finding 1) or queryable by a stranger (Finding 2's root
    // cause). A user may only claim the entry for their own uid, and may
    // never overwrite a code that already belongs to someone else.
    match /codes/{code} {
      allow get: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid)
        && validDisplayName(request.resource.data.displayName);
    }

    // Shared, mutual friendship links
    match /friendships/{id} {
      allow read:   if signedIn() && request.auth.uid in resource.data.uids;
      allow create: if signedIn() && request.auth.uid in request.resource.data.uids
                    && request.resource.data.uids.size() == 2;
      allow delete: if signedIn() && request.auth.uid in resource.data.uids;
    }
  }
}
