# Local end-to-end tests against the Firebase emulators. Demo values only:
# "demo-" projects never touch real Firebase.
VITE_USE_EMULATORS=1
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-11plus.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-11plus
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_SENTRY_DSN=
